								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/teams/{{teamId}}/members",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"teams",
								"{{teamId}}",
								"members"
							]
						},
						"description": "List all members of a specific team with their roles."
					},
					"response": []
				},
				{
					"name": "Add Team Member",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"role\": \"MEMBER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/teams/{{teamId}}/members",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"teams",
								"{{teamId}}",
								"members"
							]
						},
						"description": "Add a member to team. Requires OWNER or ADMIN role. Role can be OWNER, ADMIN, or MEMBER (default)."
					},
					"response": []
				},
				{
					"name": "Remove Team Member",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/teams/{{teamId}}/members/{{memberUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"teams",
								"{{teamId}}",
								"members",
								"{{memberUserId}}"
							]
						},
						"description": "Remove a member from team. Requires OWNER or ADMIN role."
					},
					"response": []
				}
			],
			"description": "Team management endpoints"
		},
